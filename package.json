{
  "name": "kai-tools-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test packages/win-ipc/test/admission.test.ts packages/windows-child-env/test/env.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe:windows": "node --experimental-strip-types packages/win-ipc/scripts/windows-probe.ts",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
